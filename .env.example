APPLICATION_URL=http://localhost:3000

# Database. `bun run dev` ignores these and runs PGlite on loopback instead;
# `bun run start` and production connect to the PostgreSQL server described here.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable
DATABASE_POOL_MAX=10
DATABASE_AUTHENTICATION=password
# For Azure: azure-managed-identity, a passwordless DATABASE_URL with sslmode=verify-full.
# Optional user-assigned identity client ID; omit for system-assigned identity.
# DATABASE_IDENTITY_CLIENT_ID=

# Port for the PGlite socket that `bun run dev` starts. Change it when another
# PostgreSQL server already listens on 5432.
# PGLITE_PORT=5433

BETTER_AUTH_SECRET=
ACCOUNT_SECRET_KEY=
BOOTSTRAP_TOKEN=
RECOVERY_TOKEN=
