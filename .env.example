APPLICATION_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable
DATABASE_POOL_MAX=10
DATABASE_AUTHENTICATION=password
# For Azure: azure-managed-identity, a passwordless DATABASE_URL with sslmode=verify-full.
# Optional user-assigned identity client ID; omit for system-assigned identity.
# DATABASE_IDENTITY_CLIENT_ID=
BETTER_AUTH_SECRET=
ACCOUNT_SECRET_KEY=
BOOTSTRAP_TOKEN=
RECOVERY_TOKEN=
